@import 'tailwindcss';
@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';
@source '../../storage/framework/views/*.php';

:root{--mint:#38c9aa;--mint-dark:#13ae93;--deep:#006a68;--ink:#355550;--pale:#f1fcf6;--aqua:#d8fff5;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--pale);color:var(--ink);font-family:var(--sans);font-size:14px}.wrap{width:min(1140px,calc(100% - 9.5%));margin-inline:auto}.hero{height:min(760px,58.6vw);min-height:560px;background-image:linear-gradient(90deg,rgba(4,29,24,.64),rgba(4,29,24,.40)),linear-gradient(0deg,rgba(3,23,19,.34),rgba(3,23,19,.08) 55%),url("/image/hero.jpg");background-size:cover;background-position:center 56%;color:#fff;position:relative;display:flex;flex-direction:column}.hero:after{content:'';position:absolute;inset:auto 0 0;height:35%;background:linear-gradient(0deg,rgba(2,19,16,.65),transparent);pointer-events:none}.nav{height:72px;display:flex;align-items:center;justify-content:space-between;position:relative;z-index:2}.brand{font-weight:700;color:inherit;text-decoration:none;font-size:19px;display:inline-flex;align-items:center;gap:5px}.brand-mark{font-size:33px;font-weight:700;line-height:0;transform:rotate(-25deg);display:inline-block}.nav-links{display:flex;gap:46px}.nav a{color:inherit;text-decoration:none;font-size:13px}.button{display:inline-flex;align-items:center;justify-content:center;background:var(--mint);color:white;padding:13px 25px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 5px 12px #169a7b22;transition:transform .2s,background .2s}.button:hover{background:var(--mint-dark);transform:translateY(-2px)}.button-small{padding:10px 18px}.button-ghost{background:transparent;border:1px solid #ffffffa3}.menu-toggle{display:none}.hero-content{z-index:1;text-align:center;margin:auto;width:min(850px,82%);padding:35px 0}.eyebrow{font-size:10px;font-weight:700;letter-spacing:.18em;color:#fff;opacity:.78;margin:0 0 13px}.eyebrow.teal{color:var(--mint-dark);opacity:1}.hero h1{font-family:var(--serif);font-size:clamp(32px,4vw,54px);line-height:1.19;margin:0 auto 24px;max-width:850px}.hero-content>p:not(.eyebrow){font-size:15px;line-height:1.8;max-width:760px;margin:0 auto 25px;color:#f0f8f5}.hero-actions{display:flex;justify-content:center;gap:14px}.scroll-cue{position:absolute;z-index:2;bottom:16px;left:50%;color:white;text-decoration:none;font-size:28px}.section{position:relative;overflow:hidden}.about{padding:100px 0 88px;background:#f3fcf6}.about-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:100px;align-items:center}.section h2{font:600 clamp(30px,3.3vw,43px)/1.2 var(--serif);letter-spacing:.02em;color:var(--mint);margin:0}.flourish{display:block;color:var(--mint);font:26px var(--serif);height:34px}.body-copy,.team-grid p,.promo-grid p{font-size:13px;line-height:1.8;color:#657b75}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:28px 0 23px}.stats div{text-align:center}.stats b{display:block;color:#475e59;font-size:23px}.stats span{display:block;font-size:10px;margin-top:6px}.visual{display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background-color:#d1e9df;color:#138d7b;font-size:11px;letter-spacing:.18em;font-weight:700;text-align:center}.visual:before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 75% 22%,#fff9 0 3%,transparent 35%),linear-gradient(145deg,#b6daca,#edf5e8 50%,#c5ddd1)}.visual span{z-index:1;border:1px solid #ffffffa1;background:#f5fff0a6;border-radius:30px;padding:11px 16px}.visual-therapist{display:block;width:100%;height:440px;object-fit:cover;object-position:center;border-radius:17px;box-shadow:0 12px 22px #144f3a26}.leaf{position:absolute;color:var(--mint);font:140px var(--serif);opacity:.8}.leaf-top{top:-35px;left:-25px;transform:rotate(90deg)}.leaf-bottom{bottom:-65px;right:-15px;transform:rotate(-40deg)}.services{padding:100px 0 106px;background:#d8fff5}.section-heading{text-align:center;margin-bottom:38px}.section-heading>p:last-child{font-size:12px;line-height:1.7;color:#71847d;margin:0}.section-heading .flourish{height:29px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px 27px}.service-card{background:#fff;border:1px solid #a7efdf;border-radius:13px;padding:10px;box-shadow:0 7px 18px #167e6523}.service-img{height:185px;border-radius:8px}.service-img:before{background:linear-gradient(145deg,#d5c6a4,#f3e8d8 38%,#b5d3bc 72%,#728d73)}.img-two:before{background:linear-gradient(140deg,#a4b87b,#e6d1ad 48%,#6c8856)}.img-three:before{background:linear-gradient(145deg,#dfa95f,#697c47 50%,#ead6a7)}.img-four:before{background:linear-gradient(145deg,#dbc9a9,#f7e8d8 50%,#b8cbad)}.img-five:before{background:linear-gradient(140deg,#d9b8a3,#f5e5da 50%,#c49689)}.img-six:before{background:linear-gradient(140deg,#e8d0ad,#c6a686 55%,#f1dfc8)}.card-copy{padding:13px 3px 6px}.card-copy h3{font:600 16px var(--serif);color:var(--mint-dark);margin:0 0 7px}.card-copy p{font-size:10px;color:#82918b;line-height:1.65;margin:0}.services-leaf{right:-40px;top:7px;transform:rotate(-35deg)}.benefits{padding:100px 0 105px;background:#f3fcf6}.section-heading.left{text-align:left;margin-bottom:30px}.section-heading.left>p:last-child{margin-top:9px}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px 26px}.benefit-grid article{background:#fff;border-radius:14px;min-height:148px;padding:25px 23px;box-shadow:0 5px 20px #316c5310}.benefit-grid article>span{font-size:26px;color:var(--mint)}.benefit-grid h3{font:600 15px var(--serif);margin:10px 0 5px;color:#475e59}.benefit-grid p{font-size:10px;line-height:1.65;color:#82918b;margin:0}.benefits-leaf{right:-34px;top:35px;transform:rotate(-25deg)}.team{padding:40px 0 55px;background:#f3fcf6}.team-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:70px;align-items:center}.team-grid h2{font-size:clamp(29px,3.2vw,42px)}.team-grid>div:last-child{text-align:right}.team-grid .eyebrow{text-align:right}.team-grid .flourish{text-align:right}.team-visual{height:530px;border-radius:47% 53% 44% 56% / 41% 43% 57% 59%;background:#cafff2}.team-visual:before{inset:10%;border-radius:50%;background:linear-gradient(130deg,#d0eee1,#9bcab8 50%,#2f9b84)}.team-grid .button{margin-top:12px;min-width:180px}.app-promo{padding:60px 0 100px;background:radial-gradient(ellipse at 73% 68%,#d0fff4 0 40%,transparent 40.2%),#f3fcf6}.promo-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;align-items:center}.promo-grid h2{max-width:430px}.phone-visual{height:520px;background:#d6fff4;border-radius:50%;max-width:520px;margin:auto;width:100%}.phone-visual:before{inset:7%;border-radius:50%;background:radial-gradient(circle at 50% 50%,#087c76 0 60%,#21ab98 60% 100%)}.phone-visual span{color:#fff;background:#006d6899}.store-links{display:flex;gap:12px;margin-top:18px}.store-badge{background:#111;color:white;text-decoration:none;border-radius:7px;padding:6px 12px;display:flex;gap:7px;align-items:center;font-size:19px}.store-badge span{font-size:8px;line-height:1.2}.store-badge strong{display:block;font-size:13px}.faq{background:#00706b;color:white;padding:55px 0}.faq-row{display:flex;align-items:center;justify-content:space-between}.faq h2{color:white}footer{background:#35c7a9;color:white}.footer-grid{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:36px;padding-top:47px;padding-bottom:40px}.footer-grid h3{font-size:14px;margin:18px 0 13px}.footer-grid p,.footer-grid>div>a:not(.brand){font-size:11px;line-height:2;color:#edfffa}.footer-grid>div>a:not(.brand){display:block;text-decoration:none}.copyright{text-align:center;background:#006d68;padding:14px;font-size:10px}
@media(max-width:800px){.wrap{width:min(680px,calc(100% - 40px))}.hero{height:680px;min-height:0}.nav-links{gap:20px}.about-grid{gap:40px}.visual-therapist{height:360px}.service-grid{gap:15px}.service-img{height:145px}.team-grid{gap:35px}.team-visual{height:410px}.phone-visual{height:400px}.footer-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:580px){body{font-size:13px}.hero{height:620px}.nav{height:67px}.nav-links{display:none;position:absolute;top:58px;left:0;right:0;padding:18px;background:#064a42;flex-direction:column;gap:17px;border-radius:10px}.nav-links.open{display:flex}.nav>.button{margin-left:auto;margin-right:12px;padding:9px 12px;font-size:10px}.brand{font-size:16px}.brand-mark{font-size:26px}.menu-toggle{display:block;background:none;border:0;color:white;font-size:23px}.hero-content{width:calc(100% - 38px)}.hero h1{font-size:35px}.hero-content>p:not(.eyebrow){font-size:13px}.button{padding:12px 16px}.about,.services,.benefits{padding:70px 0}.about-grid,.team-grid,.promo-grid{grid-template-columns:1fr;gap:34px}.about-grid{display:flex;flex-direction:column}.about-grid>div:first-child{order:1}.visual-therapist{height:330px;width:80%;align-self:flex-end}.section h2{font-size:31px}.stats{grid-template-columns:repeat(2,1fr);gap:18px}.section-heading{margin-bottom:26px}.section-heading br{display:none}.service-grid,.benefit-grid{grid-template-columns:repeat(2,1fr);gap:13px}.service-card{padding:7px}.service-img{height:112px}.service-img span{font-size:8px;letter-spacing:.08em;padding:7px}.card-copy{padding:10px 2px 5px}.card-copy h3{font-size:13px}.card-copy p{font-size:9px}.benefit-grid article{padding:16px 13px;min-height:142px}.benefit-grid h3{font-size:13px}.benefits-leaf{font-size:90px}.team-grid>div:last-child{text-align:left}.team-grid .eyebrow,.team-grid .flourish{text-align:left}.team-visual{height:350px;width:80%}.promo-grid{gap:22px}.promo-grid h2{max-width:350px}.phone-visual{height:330px;width:90%}.app-promo{padding:65px 0 75px}.faq-row{align-items:flex-start;gap:25px;flex-direction:column}.faq{padding:43px 0}.footer-grid{grid-template-columns:repeat(2,1fr);gap:18px;padding:32px 0}.footer-grid>div:first-child{grid-column:1/-1}.copyright{padding:12px}.leaf-top{font-size:90px}.leaf-bottom{font-size:90px}.desktop-only{display:none}}
